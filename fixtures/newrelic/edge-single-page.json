{
  "name": "Single Page Latency",
  "description": "One page only; converter must not emit row panels",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Only Page",
      "description": "",
      "widgets": [
        {
          "title": "p95 latency",
          "layout": { "column": 1, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1234567,
                "query": "SELECT percentile(duration, 95) FROM Transaction WHERE appName = 'checkout' TIMESERIES SINCE 3 hours ago"
              }
            ]
          }
        },
        {
          "title": "Throughput",
          "layout": { "column": 7, "row": 1, "width": 6, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1234567,
                "query": "SELECT count(*) FROM Transaction WHERE appName = 'checkout' SINCE 3 hours ago"
              }
            ]
          }
        },
        {
          "title": "By endpoint",
          "layout": { "column": 1, "row": 4, "width": 12, "height": 3 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 1234567,
                "query": "SELECT average(duration) FROM Transaction WHERE appName = 'checkout' FACET name LIMIT 20 SINCE 3 hours ago"
              }
            ]
          }
        }
      ]
    }
  ],
  "variables": []
}
